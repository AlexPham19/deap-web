# Set production values through the Site runtime environment settings, never in source.
# Secrets: TWILIO_AUTH_TOKEN, SMS_TEST_TO, SMS_ADMIN_EMAIL.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Alternatively use a sender pool instead of TWILIO_FROM_NUMBER:
TWILIO_MESSAGING_SERVICE_SID=
# For a new trial account, use its recipient-assigned From number and this fixed template:
TWILIO_TRIAL_TEMPLATE=
SMS_TEST_TO=
SMS_ADMIN_EMAIL=
